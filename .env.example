# ──────────────────────────────────────────────────────────────
# Plantilla de variables de entorno para posib.dev
# Copia este archivo a .env.local (desarrollo) y configura los
# valores reales en el panel de Vercel para producción.
# NUNCA pongas secretos reales en este archivo: está versionado.
# ──────────────────────────────────────────────────────────────

# ── Clerk (autenticación) ─────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<tu-clerk-publishable-key>
CLERK_SECRET_KEY=<tu-clerk-secret-key>
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk 6.x: usar *_FALLBACK_REDIRECT_URL (las antiguas *_AFTER_SIGN_IN_URL no surten efecto)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── Aplicación ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://posib.dev
NEXT_PUBLIC_URL=https://posib.dev

# ── Super admin ───────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=admin@example.com

# ── Cloudflare Workers API ────────────────────────────────────
NEXT_PUBLIC_CLOUDFLARE_API_URL=https://tienda-pos-api.julii1295.workers.dev

# ── ePayco (pasarela de pago) ─────────────────────────────────
EPAYCO_P_CUST_ID_CLIENTE=xxxxxxx
NEXT_PUBLIC_EPAYCO_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
EPAYCO_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
EPAYCO_P_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_EPAYCO_ENV=

# ── Cloudinary (hosting de imágenes) ──────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=xxxxxxxx
NEXT_PUBLIC_CLOUDINARY_API_KEY=xxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Otros servicios ───────────────────────────────────────────
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=<tu-resend-api-key>
CRON_SECRET=genera-un-valor-aleatorio-largo
